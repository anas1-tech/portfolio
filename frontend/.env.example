# Only needed when the API is on a different origin than the site.
# Leave unset to use the same-origin "/api" (Vite proxy in dev, nginx in Docker).
# VITE_API_URL=https://api.example.com/api

# Public address of the site, used for canonical/Open Graph/sitemap tags.
# On Render you can leave it unset: RENDER_EXTERNAL_URL is used automatically.
# VITE_SITE_URL=https://your-name.onrender.com
