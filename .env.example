# Copy to .env next to docker-compose.yml. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me

# Admin account, created automatically on first start
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me-too
DJANGO_SUPERUSER_EMAIL=you@example.com

# Public address(es). Change when you deploy on a domain.
WEB_PORT=8080

# Docker Hub repository for `docker compose push` (one private repo holds both images as tags)
DOCKER_REPO=your-dockerhub-username/portfolio
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Optional: get contact-form messages by email
CONTACT_EMAIL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
